# The base URL of the SendLit API (apps/api). Server-side only — never exposed
# to the browser. All requests from the browser go through this app's own
# /api/proxy route, which forwards the session cookie as-is.
API_URL=http://localhost:5000

# Must match this app's own public origin. Sent to the API's hosted /login
# page as the `redirect` target after sign-in — must match the API's own
# WEB_CLIENT env var, which allowlists it.
WEB_CLIENT=http://localhost:3000

# Number of rows loaded by each dashboard list page (maximum 50).
ITEMS_PER_PAGE=10

# Maximum size (in bytes) accepted for image uploads in the email image
# picker. Defaults to 10MB if unset.
MAX_UPLOAD_SIZE=10485760

# Optional: PostHog product analytics, identify, and session recording.
# Read at request time (not baked into `next build`) so a prebuilt OSS image
# can enable telemetry at container start. When unset, PostHog is disabled.
# Use the same project token as apps/api. Enable Session replay on the
# PostHog project to record dashboard sessions.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Reported as the deployment environment (falls back to NODE_ENV).
DEPLOY_ENV=
