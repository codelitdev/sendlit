{
    "name": "@sendlit/api",
    "version": "0.1.0",
    "private": true,
    "description": "Better Auth protected REST API for composing, sending and automating email — the SendLit backend",
    "license": "AGPL-3.0-or-later",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "dev": "nodemon --exec 'node --env-file=.env --import tsx' src/index.ts",
        "access-token": "tsx --env-file=.env scripts/token.ts",
        "start": "node dist/index.js",
        "db:migrate": "node --import dotenv/config dist/db/migrate.js",
        "db:generate": "drizzle-kit generate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc -p tsconfig.test.json"
    },
    "dependencies": {
        "@better-auth/cimd": "1.7.0-rc.4",
        "@better-auth/oauth-provider": "1.7.0-rc.4",
        "@codelitdev/oauth-server-kit": "0.1.0-alpha.1",
        "@modelcontextprotocol/node": "^2.0.0",
        "@modelcontextprotocol/server": "^2.0.0",
        "@sendlit/api-contract": "workspace:*",
        "@sendlit/email-blocks": "workspace:*",
        "@sendlit/email-editor": "workspace:*",
        "@ts-rest/express": "^3.52.1",
        "@ts-rest/open-api": "^3.52.1",
        "better-auth": "1.7.0-rc.4",
        "bullmq": "^5.79.2",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "express": "^4.22.2",
        "express-rate-limit": "^7.5.1",
        "ioredis": "^5.11.1",
        "jsdom": "^25.0.1",
        "jsonwebtoken": "^9.0.3",
        "liquidjs": "^10.29.0",
        "medialit": "0.2.0",
        "nanoid": "^5.1.16",
        "nodemailer": "^9.1.1",
        "pg": "^8.22.0",
        "pino": "^10.3.1",
        "pino-opentelemetry-transport": "^3.0.0",
        "posthog-node": "^5.39.4",
        "svix": "^1.97.0",
        "swagger-ui-express": "^5.0.1",
        "uuidv7": "^1.2.1",
        "zod": "^3.25.76",
        "zod-to-json-schema": "^3.25.2"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.2.17",
        "@modelcontextprotocol/client": "^2.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/jsdom": "^21.1.7",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.20.0",
        "@types/nodemailer": "^6.4.24",
        "@types/pg": "^8.20.0",
        "@types/swagger-ui-express": "^4.1.8",
        "drizzle-kit": "^0.28.1",
        "nodemon": "^3.1.14",
        "tsx": "^4.22.4",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    }
}
