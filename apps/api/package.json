{
  "name": "@sendlit/api",
  "version": "0.1.0",
  "private": true,
  "description": "Better Auth protected REST API for composing, sending and automating email \u2014 the SendLit backend",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "prebuild": "codelit-billing generate --check --config billing.config.ts",
    "build": "tsc --noEmit",
    "dev": "bun --watch src/index.ts",
    "access-token": "bun scripts/token.ts",
    "billing": "bun scripts/billing.ts",
    "billing:generate": "codelit-billing generate --config billing.config.ts",
    "billing:generate:check": "codelit-billing generate --check --config billing.config.ts",
    "start": "bun src/index.ts",
    "db:migrate": "bun src/db/migrate.ts",
    "db:generate": "codelit-billing generate --config billing.config.ts && drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "bun test --parallel --timeout 20000 src",
    "typecheck": "tsc --noEmit",
    "check:auth-schema": "bun run build:deps && bun test --timeout 30000 src/auth/schema-drift.test.ts",
    "check:drift": "bun run billing:generate:check && bun run check:auth-schema",
    "test:conformance": "bun run build:deps && bun test --timeout 30000 src/platform-conformance.test.ts src/mcp/parity.test.ts",
    "lint": "biome lint .",
    "build:deps": "bun --filter @sendlit/email-editor build && bun --filter @sendlit/email-blocks build"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@codelitdev/billing": "0.4.1",
    "@codelitdev/mcp-server-kit": "0.4.1",
    "@codelitdev/oauth-server-kit": "0.4.1",
    "@codelitdev/observability": "0.4.1",
    "@codelitdev/platform": "0.4.1",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@sendlit/api-contract": "workspace:*",
    "@sendlit/email-blocks": "workspace:*",
    "@sendlit/email-editor": "workspace:*",
    "@ts-rest/express": "3.52.1",
    "better-auth": "1.7.7",
    "bullmq": "^5.79.2",
    "cors": "^2.8.6",
    "dodopayments": "2.48.0",
    "drizzle-orm": "0.45.2",
    "express": "4.21.2",
    "express-rate-limit": "^7.5.1",
    "ioredis": "^5.11.1",
    "jsdom": "^25.0.1",
    "jsonwebtoken": "^9.0.3",
    "liquidjs": "^10.29.0",
    "medialit": "0.2.0",
    "nanoid": "^5.1.16",
    "nodemailer": "^9.1.1",
    "pg": "8.23.0",
    "svix": "^1.97.0",
    "swagger-ui-express": "^5.0.1",
    "uuidv7": "^1.2.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@better-auth/core": "1.7.7",
    "@codelitdev/platform-conformance": "0.4.1",
    "@electric-sql/pglite": "0.5.8",
    "@modelcontextprotocol/client": "^2.0.0",
    "@sendlit/test-utils": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsdom": "^21.1.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.0",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3"
  }
}
