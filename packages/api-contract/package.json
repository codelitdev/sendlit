{
  "name": "@sendlit/api-contract",
  "private": true,
  "version": "0.1.0",
  "description": "Shared ts-rest contract (Zod schemas + route definitions) for the SendLit API \u2014 single source of truth for server validation, the OpenAPI doc, and the typed web client",
  "author": "SendLit",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./schemas/*": "./src/schemas/*.ts",
    "./openapi": "./src/openapi.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@ts-rest/core": "3.52.1",
    "@ts-rest/open-api": "3.52.1",
    "zod": "3.25.76"
  }
}
