{
    "exclude": ["dist", "build", "node_modules"],
    "compilerOptions": {
        "outDir": "./dist",
        "lib": ["es2020"],
        "types": ["node"],
        "strict": true,
        "module": "esnext",
        "moduleResolution": "node",
        "target": "es2020",
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true
    },
    "include": ["src/**/*"]
}
