{
    "name": "sendlit",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "dev:api": "pnpm --filter @sendlit/api dev",
        "dev:web": "pnpm --filter @sendlit/web dev",
        "dev:docs": "pnpm --filter @sendlit/docs dev",
        "ci:publish": "pnpm publish -r --no-git-checks",
        "lint": "eslint packages apps --quiet",
        "prettier": "prettier --write packages apps *.md",
        "prepare": "husky",
        "test": "pnpm --filter @sendlit/api test && pnpm --filter @sendlit/web test && pnpm --filter @sendlit/email-editor test && pnpm --filter @sendlit/email-blocks test"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@11.11.0",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.11.0",
            "onFail": "download"
        }
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.0",
        "eslint": "^9.39.4",
        "eslint-config-next": "16.0.3",
        "eslint-config-prettier": "^8.10.2",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^15.15.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.5.2",
        "prettier": "^3.9.4",
        "typescript-eslint": "^8.62.1"
    },
    "type": "module"
}
